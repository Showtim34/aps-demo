APP_NAME=APS Lab Monitor
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg://apslab:apslab@db:5432/apslab
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin123
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_URL=ws://localhost:9001
MQTT_TELEMETRY_TOPIC=aps/telemetry/measurements
MQTT_EVENTS_TOPIC_PREFIX=aps/events
